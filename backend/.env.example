# Salin ke backend/.env lalu isi kredensial sendiri. Jangan commit file .env.
# Nilai non-kredensial di bawah sama dengan default di kode.
# Komentar harus di baris sendiri: docker --env-file tidak membuang komentar di akhir baris.

# Kredensial (wajib diisi sendiri)
# GROQ_API_KEY: agent W7-W8, RAG, dan transkripsi provider groq
GROQ_API_KEY=
# GEMINI_API_KEY: transkripsi provider gemini
GEMINI_API_KEY=
# HUGGINGFACE_TOKEN: label speaker pyannote untuk provider groq dan local
HUGGINGFACE_TOKEN=

# Transkripsi (pipeline deterministik, W6)
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# Kosong = deteksi otomatis, disarankan untuk meeting campuran EN dan ID
GEMINI_TRANSCRIBE_LANGUAGE=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Kosongkan untuk deteksi otomatis, misalnya meeting berbahasa Inggris
GROQ_WHISPER_LANGUAGE=id
LOCAL_WHISPER_MODEL=openai/whisper-large-v3

# Retrieval dan RAG (W6)
CHUNK_TARGET_WORDS=60
CHUNK_OVERLAP_SEGMENTS=1
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# auto | groq | local
LLM_PROVIDER=auto
GROQ_LLM_MODEL=openai/gpt-oss-20b
RAG_LLM_MODEL=Qwen/Qwen2-0.5B-Instruct

# Agent W7-W8 (backend/agent/config.py)
AGENT_MODEL=openai/gpt-oss-20b
# low | medium | high
AGENT_REASONING_EFFORT=low
AGENT_TEMPERATURE=0.2
AGENT_MAX_COMPLETION_TOKENS=2048
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_ERRORS=2

# Laporan dan email (Tahap 3)
# dry_run = tulis file .eml ke data/agent/outbox; smtp = kirim sungguhan
EMAIL_MODE=dry_run
# Satu-satunya penerima yang diizinkan. Agent tidak bisa mengubahnya.
REPORT_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
# 465 = SSL, 587 = STARTTLS
SMTP_PORT=465
# Kredensial SMTP (wajib bila EMAIL_MODE=smtp): alamat Gmail dan App Password 16 karakter
SMTP_USER=
SMTP_APP_PASSWORD=
# Nama tampilan pengirim di inbox penerima
MAIL_FROM_NAME=MeetRecall AI
